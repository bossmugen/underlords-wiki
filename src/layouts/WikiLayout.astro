---
import "../styles/global.css";
const { title = "Underlords Wiki", description = "Underlords character and story wiki." } = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  ["Chronicle","/seasons"],
  ["Character Codex","/characters"],
  ["Major Incidents","/episodes"],
  ["Orders","/factions"],
  ["Bonds","/relationships"],
  ["Domains","/locations"],
  ["Legends","/gags"],
  ["Quotes","/quotes"],
  ["Relics","/gallery"],
  ["Archive","/archive"],
];
const hrefFor = (href: string) => `${base}${href}` || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={hrefFor("/")}>
        <span class="brand-sigil">UL</span>
        <span><b>UNDERLORDS</b><small>CHRONICLE & CHARACTER WIKI</small></span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {nav.map(([label, href]) => <a href={hrefFor(href)} aria-current={path.includes(href) ? "page" : undefined}>{label}</a>)}
      </nav>
    </header>
    <main class="page"><slot /></main>
    <footer class="page footer">
      <strong>UNDERLORDS CHRONICLE</strong>
      <span>est. 2020 · characters, eras, incidents, legends, relics, and archive-backed continuity</span>
    </footer>
    <script define:vars={{ base }}>
      if (base) {
        document.querySelectorAll('a[href^="/"]').forEach((link) => {
          const href = link.getAttribute('href');
          if (href && !href.startsWith(`${base}/`) && href !== base) {
            link.setAttribute('href', `${base}${href}`);
          }
        });
      }
    </script>
  </body>
</html>
