---
import WikiLayout from "../layouts/WikiLayout.astro";
import { gags } from "../data/wiki";
---
<WikiLayout title="Legends | Underlords Wiki" description="Recurring Underlords jokes, bits, rituals, callbacks, and house grammar that survived long enough to become continuity.">
  <section class="hero"><div><div class="kicker">LEGENDS · CURSES · RECURRING BITS</div><h1>Legends</h1><p class="tagline">First it is a joke. Then it happens again. Then somebody names a role after it, builds a bot around it, puts it in a profile, or resurrects it three years later. At that point it has entered the canon whether dignity approves or not.</p></div></section>
  <section class="section"><div class="index-list">{gags.map((gag)=><article class="index-card" id={gag.id}><small>PERSISTENT LEGEND</small><h3>{gag.name}</h3><p>{gag.logline}</p></article>)}</div></section>
</WikiLayout>
