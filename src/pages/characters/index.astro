---
import WikiLayout from "../../layouts/WikiLayout.astro";
import "../../styles/characters.css";
import { castGroups, characterById } from "../../data/cast";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}${path}` || path;
---
<WikiLayout title="Character Codex | Underlords Wiki" description="The Underlords cast, grouped by the actual UL roster structure and historical affiliations.">
  <section class="hero cast-hero">
    <div>
      <div class="kicker">CHARACTER CODEX</div>
      <h1>The Cast</h1>
      <p class="tagline">Founders, Officers, Snipers, specialists, Staff, Platelets, VIPs, old friends, returnees, and people who somehow acquired enough aliases to require continuity control.</p>
    </div>
  </section>

  <section class="cast-index" aria-label="Character groups">
    {castGroups.map((group) => (
      <a href={`#${group.id}`}><span>{group.label}</span><small>{group.characterIds.filter((id) => characterById.has(id)).length}</small></a>
    ))}
  </section>

  {castGroups.map((group, index) => {
    const groupCharacters = group.characterIds.map((id) => characterById.get(id)).filter(Boolean);
    if (!groupCharacters.length) return null;
    return (
      <section class="section cast-section" id={group.id}>
        <div class="section-head">
          <h2>{group.label}</h2>
          <p>{group.note}</p>
        </div>
        <div class="cast-grid">
          {groupCharacters.map((character) => character && (
            <a class="cast-card" data-initial={character.name[0]} href={url(`/characters/${character.id}`)}>
              <div class="cast-card-top">
                <small>{character.role}</small>
                <span>{character.era}</span>
              </div>
              <strong>{character.name}</strong>
              {character.aliases?.length ? <div class="cast-aliases">{character.aliases.slice(0,3).join(" · ")}</div> : null}
              <p>{character.logline}</p>
              <div class="cast-card-footer">OPEN CODEX ENTRY <b>→</b></div>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  <section class="section cast-rule">
    <div class="section-head"><h2>One person. One continuity.</h2><p>Ranks change. Accounts change. Display names mutate. The character file follows the human instead of cloning them every time Discord develops a new problem.</p></div>
  </section>
</WikiLayout>
