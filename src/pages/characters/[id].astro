---
import WikiLayout from "../../layouts/WikiLayout.astro";
import "../../styles/characters.css";
import "../../styles/dossiers.css";
import "../../styles/narrative.css";
import { allEpisodes } from "../../data/all-content";
import { allCharacters, primaryGroupByCharacterId } from "../../data/cast";
import { resolveCharacterPageData, type CharacterClaim } from "../../data/character-page-data";
import dossierData from "../../data/character-dossiers.generated.json";

type Dossier = {
  html: string;
  wordCount: number;
  claims?: CharacterClaim[];
  antiFanon?: string[];
  relatedPeople?: string[];
  sourcePath: string;
  sourceRef: string;
};

export function getStaticPaths() {
  return allCharacters.map((character) => ({ params: { id: character.id }, props: { character } }));
}

const { character } = Astro.props;
const { bio, narrative } = resolveCharacterPageData(character);
const dossiers = dossierData as Record<string, Dossier>;
const dossier = dossiers[character.id];
const receiptClaims: CharacterClaim[] = [...(bio.claims ?? []), ...(dossier?.claims ?? [])];
const dedupedReceiptClaims = receiptClaims.filter((claim, index, all) =>
  all.findIndex((candidate) => `${candidate.date ?? ""}\u0000${candidate.text}` === `${claim.date ?? ""}\u0000${claim.text}`) === index,
);
const primaryGroup = primaryGroupByCharacterId.get(character.id);
const identityNames = new Set([character.name, ...(character.aliases ?? [])].map((name) => name.toLowerCase()));
const appearances = allEpisodes.filter((episode) => episode.cast.some((name) => identityNames.has(name.toLowerCase())));
const characterByName = new Map<string, any>();
for (const person of allCharacters) {
  characterByName.set(person.name.toLowerCase(), person);
  for (const alias of person.aliases ?? []) characterByName.set(alias.toLowerCase(), person);
}
const relatedNames = [
  ...(character.relationships?.map((relationship) => relationship.name) ?? []),
  ...(bio.relatedPeople ?? []),
  ...(dossier?.relatedPeople ?? []),
];
const relatedCharacters = [...new Set(relatedNames.map((name) => characterByName.get(name.toLowerCase())?.id).filter(Boolean))]
  .map((id) => allCharacters.find((person) => person.id === id))
  .filter(Boolean)
  .slice(0, 2);
const [firstRaw = "not established", lastRaw = ""] = character.era.split("–");
const firstSpotted = firstRaw.trim() || "not established";
const lastSeen = lastRaw.trim() || "not established";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}${path}` || path;
const evidenceLabel = (value?: string) => value ? value.replaceAll("-", " ").toUpperCase() : "ARCHIVE NOTE";
---
<WikiLayout title={`${character.name} | Underlords`} description={bio.dek ?? character.logline}>
  <div class="breadcrumbs"><a href={url("/characters")}>Strippers</a> / {primaryGroup?.label ?? "More Strippers"} / {character.name}</div>

  <section class="hero character-hero">
    <div>
      <div class="kicker">{primaryGroup?.label ?? "STRIPPER FILE"} · {character.era}</div>
      <h1>{character.name}</h1>
      <p class="tagline">{bio.dek ?? character.logline}</p>
      {character.aliases?.length ? <div class="hero-aliases alias-label"><b>ALSO ANSWERS TO</b> {character.aliases.join(" · ")}</div> : null}
    </div>
  </section>

  <section class="section detail-layout character-detail">
    <article class="detail-main character-biography">
      {narrative ? (
        <section class="bio-block narrative-biography">
          <div class="narrative-label">THEIR WHOLE DEAL</div>
          <h2>{character.name}</h2>
          <div class="narrative-intro">{narrative.intro.map((paragraph) => <p>{paragraph}</p>)}</div>
          <div class="narrative-sections">
            {narrative.sections.map((section) => (
              <section class="narrative-era">
                <div class="narrative-period">{section.period ?? ""}</div>
                <div><h3>{section.title}</h3>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
              </section>
            ))}
          </div>
          {narrative.closing?.length ? <div class="narrative-closing">{narrative.closing.map((paragraph) => <p>{paragraph}</p>)}</div> : null}
        </section>
      ) : (
        <>
          <section class="bio-block bio-opening">
            <div class="bio-label">THEIR WHOLE DEAL</div>
            <h2>Who is {character.name}?</h2>
            {bio.overview.map((paragraph: string) => <p>{paragraph}</p>)}
          </section>
          {bio.history?.length ? (
            <section class="bio-block">
              <div class="bio-label">THE STORY SO FAR</div>
              <h2>Life in Underlords</h2>
              <div class="bio-timeline">
                {bio.history.map((beat: any) => (
                  <article class="bio-beat">{beat.date ? <time>{beat.date}</time> : null}<div><h3>{beat.title}</h3><p>{beat.text}</p></div></article>
                ))}
              </div>
            </section>
          ) : null}
        </>
      )}

      {character.relationships?.length ? (
        <section class="bio-block">
          <div class="bio-label">KNOWN ASSOCIATES</div>
          <h2>Who keeps getting dragged into frame</h2>
          <div class="relationship-list">
            {character.relationships.map((relationship) => relationship.href ? (
              <a class="relationship-row" href={url(relationship.href)}><span>{relationship.name}</span><p>{relationship.note}</p><b>→</b></a>
            ) : <div class="relationship-row"><span>{relationship.name}</span><p>{relationship.note}</p></div>)}
          </div>
        </section>
      ) : null}

      {bio.characterNotes?.length ? (
        <section class="bio-block">
          <div class="bio-label">PETTY CRIMES</div>
          <h2>Petty Crimes</h2>
          <div class="character-note-grid">
            {bio.characterNotes.map((note: any) => <article class="character-note"><h3>{note.title}</h3><p>{note.text}</p></article>)}
          </div>
        </section>
      ) : null}

      {appearances.length ? (
        <section class="bio-block">
          <div class="bio-label">EPISODES & INCIDENTS</div>
          <h2>Stories that pull {character.name} into frame</h2>
          <div class="episode-list">
            {appearances.map((episode) => (
              <a class="episode-row" href={url(`/episodes/${episode.id}`)}>
                <span class="ep-season">{episode.season}</span><strong>{episode.title}</strong><p>{episode.logline}</p><time>{episode.date}</time>
              </a>
            ))}
          </div>
        </section>
      ) : null}

      {character.quotes?.length ? (
        <section class="bio-block">
          <div class="bio-label">MOUTH CRIMES</div>
          <h2>Things {character.name} sent before rereading</h2>
          <div class="quote-wall">{character.quotes.map((quote) => <div class="quote-card" data-no-public-cleanup><blockquote>“{quote}”</blockquote><footer>{character.name}</footer></div>)}</div>
        </section>
      ) : null}

      {dedupedReceiptClaims.length ? (
        <details class="receipt-drawer" data-no-public-cleanup>
          <summary>SHOW RECEIPTS</summary>
          <div class="receipt-list">
            {dedupedReceiptClaims.map((claim) => (
              <article class="receipt-item">
                <header><span>{evidenceLabel(claim.evidence)}</span>{claim.date ? <time>{claim.date}</time> : null}</header>
                <p>{claim.text}</p>
              </article>
            ))}
          </div>
        </details>
      ) : null}
    </article>

    <aside class="infobox character-infobox">
      <div class="infobox-title">{character.name}</div>
      <div class="character-monogram" aria-hidden="true">{character.name[0]}</div>
      <dl>
        <div class="row"><dt>Job(s)</dt><dd>{character.role}</dd></div>
        <div class="row"><dt>First spotted</dt><dd>{firstSpotted}</dd></div>
        <div class="row"><dt>Last seen</dt><dd title="Latest surviving coverage; not automatically a departure date">{lastSeen}</dd></div>
        {character.aliases?.length ? <div class="row"><dt>Also answers to</dt><dd>{character.aliases.join(" · ")}</dd></div> : null}
        {character.tags?.length ? <div class="row"><dt>Known for</dt><dd><div class="chip-row">{character.tags.map((tag) => <span class="chip">{tag}</span>)}</div></dd></div> : null}
      </dl>
      {bio.roleNotes?.length ? <div class="infobox-notes"><strong>EMPLOYMENT NOTES</strong><ul>{bio.roleNotes.map((note: string) => <li>{note}</li>)}</ul></div> : null}
    </aside>
  </section>

  <section class="related-module">
    <div class="related-module-head"><h2>SINCE YOU'RE SNOOPING</h2><p>Every biography should open another door instead of ending at the bottom of a file.</p></div>
    <div class="related-grid">
      {relatedCharacters.map((person) => person && <a class="related-card" href={`/characters/${person.id}`}><small>KNOWN ASSOCIATE</small><strong>{person.name}</strong><span>{person.logline}</span></a>)}
      {appearances[0] ? <a class="related-card" href={`/episodes/${appearances[0].id}`}><small>EPISODE / INCIDENT</small><strong>{appearances[0].title}</strong><span>{appearances[0].date}</span></a> : null}
      <a class="related-card" href={`/snoop?q=${encodeURIComponent(character.name)}&type=ROOMS`}><small>ELSEWHERE IN THE HOUSE</small><strong>Find the rooms</strong><span>Search where {character.name} keeps appearing.</span></a>
      <a class="related-card" href={`/snoop?q=${encodeURIComponent(character.name)}`}><small>MUGSHOTS & MORE</small><strong>Snoop the whole file</strong><span>Aliases, quotes, episodes, and Wall-adjacent results.</span></a>
    </div>
  </section>
</WikiLayout>