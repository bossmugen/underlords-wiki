---
import WikiLayout from "../../layouts/WikiLayout.astro";
import "../../styles/characters.css";
import "../../styles/dossiers.css";
import { episodes } from "../../data/wiki";
import { allCharacters, primaryGroupByCharacterId } from "../../data/cast";
import { getCharacterBio } from "../../data/character-bios";
import { officerCharacterBios } from "../../data/character-bios-officers";
import { deepOfficerCharacterBios } from "../../data/character-bios-officers-deep";
import { lateOfficerCharacterBios } from "../../data/character-bios-officers-late";
import { retiredOfficerCharacterBios } from "../../data/character-bios-retired";
import { lateRetiredOfficerCharacterBios } from "../../data/character-bios-retired-late";
import { sniperCharacterBios } from "../../data/character-bios-snipers";
import { directorCharacterBios } from "../../data/character-bios-directors";
import { extendedCharacterBios } from "../../data/character-bios-extended";
import { gameOfficerCharacterBios } from "../../data/character-bios-game-officers";
import { staffCharacterBios } from "../../data/character-bios-staff";
import { lateStaffCharacterBios } from "../../data/character-bios-staff-late";
import { finalStaffCharacterBios } from "../../data/character-bios-staff-last";
import { plateletCharacterBios } from "../../data/character-bios-platelets";
import { deepPlateletCharacterBios } from "../../data/character-bios-platelets-deep";
import { latePlateletCharacterBios } from "../../data/character-bios-platelets-late";
import { vipCharacterBios } from "../../data/character-bios-vip";
import { deepVipCharacterBios } from "../../data/character-bios-vip-deep";
import { archiveCharacterBios } from "../../data/character-bios-archive";
import dossierData from "../../data/character-dossiers.generated.json";

type DossierClaim = { text: string; evidence?: string; date?: string };
type Dossier = {
  html: string;
  wordCount: number;
  claims?: DossierClaim[];
  antiFanon?: string[];
  relatedPeople?: string[];
  sourcePath: string;
  sourceRef: string;
};

export function getStaticPaths() {
  return allCharacters.map((character) => ({ params: { id: character.id }, props: { character } }));
}

const { character } = Astro.props;
const richBio = (lateOfficerCharacterBios as Record<string, any>)[character.id] ?? (deepOfficerCharacterBios as Record<string, any>)[character.id] ?? (officerCharacterBios as Record<string, any>)[character.id] ?? (lateRetiredOfficerCharacterBios as Record<string, any>)[character.id] ?? (retiredOfficerCharacterBios as Record<string, any>)[character.id] ?? (sniperCharacterBios as Record<string, any>)[character.id] ?? (directorCharacterBios as Record<string, any>)[character.id] ?? (gameOfficerCharacterBios as Record<string, any>)[character.id] ?? (finalStaffCharacterBios as Record<string, any>)[character.id] ?? (lateStaffCharacterBios as Record<string, any>)[character.id] ?? (staffCharacterBios as Record<string, any>)[character.id] ?? (latePlateletCharacterBios as Record<string, any>)[character.id] ?? (deepPlateletCharacterBios as Record<string, any>)[character.id] ?? (plateletCharacterBios as Record<string, any>)[character.id] ?? (deepVipCharacterBios as Record<string, any>)[character.id] ?? (vipCharacterBios as Record<string, any>)[character.id] ?? (archiveCharacterBios as Record<string, any>)[character.id] ?? (extendedCharacterBios as Record<string, any>)[character.id];
const plateletRichBioGuard = new Set(["scar", "dyingfox", "ryo", "dean", "tae", "zoshaa", "candy", "cele"]);
if (plateletRichBioGuard.has(character.id) && !richBio) {
  throw new Error(`Priority Platelet character ${character.id} fell through to the generic character bio.`);
}
const vipDeepBioGuard = new Set(["rich", "zyrcant", "woohyuk"]);
if (vipDeepBioGuard.has(character.id) && !(deepVipCharacterBios as Record<string, any>)[character.id]) {
  throw new Error(`Priority VIP character ${character.id} lost its cross-archive deep bio.`);
}
const bio = richBio ?? getCharacterBio(character);
const dossiers = dossierData as Record<string, Dossier>;
const dossier = dossiers[character.id];
const canonNotes = [...new Set([...(bio.canonNotes ?? []), ...(dossier?.antiFanon ?? [])])];
const receiptClaims: DossierClaim[] = [...(bio.claims ?? []), ...(dossier?.claims ?? [])];
const dedupedReceiptClaims = receiptClaims.filter((claim, index, all) => all.findIndex((candidate) => `${candidate.date ?? ""}\u0000${candidate.text}` === `${claim.date ?? ""}\u0000${claim.text}`) === index);
const primaryGroup = primaryGroupByCharacterId.get(character.id);
const appearances = episodes.filter((episode) => episode.cast.includes(character.name));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}${path}` || path;
const evidenceLabel = (value?: string) => value ? value.replaceAll("-", " ").toUpperCase() : "ARCHIVE NOTE";
---
<WikiLayout title={`${character.name} | Underlords Wiki`} description={bio.dek ?? character.logline}>
  <div class="breadcrumbs"><a href={url("/characters")}>Characters</a> / {primaryGroup?.label ?? "Extended Cast"} / {character.name}</div>

  <section class="hero character-hero">
    <div>
      <div class="kicker">{primaryGroup?.label ?? "CHARACTER FILE"} · {character.era}</div>
      <h1>{character.name}</h1>
      <p class="tagline">{bio.dek ?? character.logline}</p>
      {character.aliases?.length ? <div class="hero-aliases">AKA {character.aliases.join(" · ")}</div> : null}
    </div>
  </section>

  <section class="section detail-layout character-detail">
    <article class="detail-main character-biography">
      <section class="bio-block bio-opening">
        <div class="bio-label">CHARACTER BIO</div>
        <h2>Who is {character.name}?</h2>
        {bio.overview.map((paragraph: string) => <p>{paragraph}</p>)}
      </section>

      {dossier?.html ? (
        <section class="bio-block archive-dossier-block">
          <div class="bio-label">FULL ARCHIVE DOSSIER</div>
          <div class="dossier-intro">
            <h2>The actual file</h2>
            <p>This is the long-form character writing carried over from the main UL archive: scenes, quotes, role context, recurring behavior, corrections, and the parts that do not survive being crushed into a card.</p>
          </div>
          <div class="archive-dossier-body" set:html={dossier.html} />
        </section>
      ) : null}

      {dedupedReceiptClaims.length ? (
        <section class="bio-block receipt-ledger-block">
          <div class="bio-label">THE RECEIPTS</div>
          <h2>What the archive actually caught</h2>
          <p class="receipt-ledger-intro">Not a résumé. Not message-count soup. These are the specific scenes and locked facts that make the character file possible.</p>
          <div class="receipt-ledger">
            {dedupedReceiptClaims.map((claim) => (
              <article class="receipt-entry">
                <div class="receipt-meta">
                  <span>{evidenceLabel(claim.evidence)}</span>
                  {claim.date ? <time>{claim.date}</time> : null}
                </div>
                <p>{claim.text}</p>
              </article>
            ))}
          </div>
        </section>
      ) : null}

      {bio.history?.length ? (
        <section class="bio-block">
          <div class="bio-label">STORY</div>
          <h2>Story so far</h2>
          <div class="bio-timeline">
            {bio.history.map((beat: any) => (
              <article class="bio-beat">
                {beat.date ? <time>{beat.date}</time> : null}
                <div><h3>{beat.title}</h3><p>{beat.text}</p></div>
              </article>
            ))}
          </div>
        </section>
      ) : null}

      {bio.characterNotes?.length ? (
        <section class="bio-block">
          <div class="bio-label">CHARACTER</div>
          <h2>Recurring bits & behavior</h2>
          <div class="character-note-grid">
            {bio.characterNotes.map((note: any) => (
              <article class="character-note">
                <h3>{note.title}</h3>
                <p>{note.text}</p>
              </article>
            ))}
          </div>
        </section>
      ) : null}

      {character.relationships?.length ? (
        <section class="bio-block">
          <div class="bio-label">CONNECTIONS</div>
          <h2>Relationships</h2>
          <div class="relationship-list">
            {character.relationships.map((rel) => rel.href ? (
              <a class="relationship-row" href={url(rel.href)}><span>{rel.name}</span><p>{rel.note}</p><b>→</b></a>
            ) : (
              <div class="relationship-row"><span>{rel.name}</span><p>{rel.note}</p></div>
            ))}
          </div>
        </section>
      ) : null}

      {appearances.length ? (
        <section class="bio-block">
          <div class="bio-label">EPISODES</div>
          <h2>Notable stories</h2>
          <div class="episode-list">
            {appearances.map((episode) => (
              <a class="episode-row" href={url(`/episodes/${episode.id}`)}>
                <span class="ep-season">{episode.season}</span>
                <strong>{episode.title}</strong>
                <p>{episode.logline}</p>
                <time>{episode.date}</time>
              </a>
            ))}
          </div>
        </section>
      ) : null}

      {character.quotes?.length ? (
        <section class="bio-block">
          <div class="bio-label">QUOTES</div>
          <h2>Lines that made the cut</h2>
          <div class="quote-wall">{character.quotes.map((quote) => <div class="quote-card"><blockquote>“{quote}”</blockquote><footer>{character.name}</footer></div>)}</div>
        </section>
      ) : null}

      <section class="bio-block source-floor">
        <div class="bio-label">DOWNSTAIRS</div>
        <h2>Canon & archive notes</h2>
        <p class="source-intro">This is where the wiki sobers up. Current roles are not automatically appointment dates. A funny relationship label is not biology. An export-time role array is not a promotion ceremony.</p>
        {canonNotes.length ? <ul class="canon-list">{canonNotes.map((note: string) => <li>{note}</li>)}</ul> : null}
      </section>
    </article>

    <aside class="infobox character-infobox">
      <div class="infobox-title">{character.name}</div>
      <div class="character-monogram" aria-hidden="true">{character.name[0]}</div>
      <dl>
        <div class="row"><dt>Primary shelf</dt><dd>{primaryGroup?.label ?? "Archive / Extended Cast"}</dd></div>
        <div class="row"><dt>Role</dt><dd>{character.role}</dd></div>
        <div class="row"><dt>Era</dt><dd>{character.era}</dd></div>
        {character.aliases?.length ? <div class="row"><dt>Aliases</dt><dd>{character.aliases.join(" · ")}</dd></div> : null}
        {character.tags?.length ? <div class="row"><dt>Tags</dt><dd><div class="chip-row">{character.tags.map((tag) => <span class="chip">{tag}</span>)}</div></dd></div> : null}
      </dl>
      {bio.roleNotes?.length ? (
        <div class="infobox-notes">
          <strong>ROLE NOTES</strong>
          <ul>{bio.roleNotes.map((note: string) => <li>{note}</li>)}</ul>
        </div>
      ) : null}
    </aside>
  </section>
</WikiLayout>