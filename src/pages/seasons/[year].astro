---
import WikiLayout from "../../layouts/WikiLayout.astro";
import { seasons } from "../../data/wiki";
import { episodesBySeason, episodeFormat } from "../../data/all-content";
import { ERA_TRANSITIONS } from "../../data/site";

export function getStaticPaths() {
  return seasons.map((season) => ({ params: { year: season.year }, props: { season } }));
}
const { season } = Astro.props;
const seasonEpisodes = episodesBySeason(season.year);
const eraIndex = seasons.findIndex((entry) => entry.year === season.year);
const eraNumber = eraIndex + 1;
const previous = eraIndex > 0 ? seasons[eraIndex - 1] : undefined;
const next = eraIndex < seasons.length - 1 ? seasons[eraIndex + 1] : undefined;
const publicTitle = season.title.replace(/^Season [^—]+ — /, "");
---
<WikiLayout title={`${season.year}: ${publicTitle} | Underlords`} description={season.summary}>
  <div class="breadcrumbs"><a href="/seasons">The Fuck Happened</a> / Era {eraNumber} / {season.year}</div>
  <section class="hero">
    <div>
      <div class="kicker">ERA {String(eraNumber).padStart(2, "0")} · {season.year}</div>
      <h1>{publicTitle}</h1>
      <p class="tagline">{season.subtitle}</p>
    </div>
  </section>

  <section class="section detail-layout">
    <article class="detail-main">
      <div class="bio-label">WHAT THE HOUSE BECAME</div>
      <h2>What changed</h2>
      <p>{season.summary}</p>

      <div class="bio-label" style="margin-top:4rem">EPISODES & INCIDENTS</div>
      <h2>What happened in here</h2>
      {seasonEpisodes.length ? (
        <div class="episode-list">
          {seasonEpisodes.map((episode) => (
            <a class="episode-row" href={`/episodes/${episode.id}`}>
              <span class="ep-season">{episodeFormat(episode)}</span>
              <strong>{episode.title}</strong>
              <p>{episode.logline}</p>
              <time>{episode.date}</time>
            </a>
          ))}
        </div>
      ) : <div class="wiki-note">No named incident page yet. The year still exists; filler mythology does not.</div>}
    </article>

    <aside class="infobox">
      <div class="infobox-title">{season.year}</div>
      <dl>
        <div class="row"><dt>Era</dt><dd>{eraNumber}</dd></div>
        <div class="row"><dt>Year</dt><dd>{season.year}</dd></div>
        <div class="row"><dt>House mood</dt><dd>{season.subtitle}</dd></div>
        <div class="row"><dt>Named files</dt><dd>{seasonEpisodes.length} episodes / incidents</dd></div>
      </dl>
    </aside>
  </section>

  <section class="related-module era-exit">
    <div class="related-module-head"><h2>SINCE YOU'RE SNOOPING</h2><p>History is not a hallway with one exit. Follow the cast, rooms, and adjacent years.</p></div>
    <div class="related-grid">
      {previous ? <a class="related-card" href={`/seasons/${previous.year}`}><small>PREVIOUSLY</small><strong>{previous.year}</strong><span>{previous.title.replace(/^Season [^—]+ — /, "")}</span></a> : <a class="related-card" href="/start-here"><small>THE FRONT DOOR</small><strong>Start with the mess</strong><span>The six-stop orientation route.</span></a>}
      <a class="related-card" href={`/snoop?q=${season.year}&type=STRIPPERS`}><small>STRIPPERS</small><strong>Who was in frame?</strong><span>Search people tied to this year.</span></a>
      <a class="related-card" href="/rooms"><small>ELSEWHERE IN THE HOUSE</small><strong>Walk the rooms</strong><span>See where the year's social life happened.</span></a>
      {next ? <a class="related-card" href={`/seasons/${next.year}`}><small>NEXT</small><strong>{ERA_TRANSITIONS[season.year] ?? next.year}</strong><span>{next.title.replace(/^Season [^—]+ — /, "")}</span></a> : <a class="related-card" href="/episodes/family-reunion"><small>AFTERLIFE</small><strong>The family reunion</strong><span>The archive catches everybody looking back.</span></a>}
    </div>
  </section>
</WikiLayout>
