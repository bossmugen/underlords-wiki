---
import WikiLayout from "../../layouts/WikiLayout.astro";
import { seasons, episodes } from "../../data/wiki";
import { integratedEpisodes } from "../../data/integrator-episodes";
import { wallIntegratedEpisodes } from "../../data/integrator-episodes-wall-20260828";
import { whiskeyIntegratedEpisodes } from "../../data/integrator-episodes-whiskey-20260829";
import { coreIntegratedEpisodes } from "../../data/integrator-episodes-core-20260829";
import { coreRecovery1535Episodes } from "../../data/integrator-episodes-core-20260829-1535";
import { allCharactersIntegratedEpisodes } from "../../data/integrator-episodes-allcharacters-20260829";
import { louvreIntegratedEpisodes } from "../../data/integrator-episodes-louvre-20260829";
import { lateAugustIntegratedEpisodes } from "../../data/integrator-episodes-20260829-1334";
import { late1737IntegratedEpisodes } from "../../data/integrator-episodes-20260829-1737";
import { late2200IntegratedEpisodes } from "../../data/integrator-episodes-20260829-2200";
import { late2235IntegratedEpisodes } from "../../data/integrator-episodes-20260829-2235";
import { late2333IntegratedEpisodes } from "../../data/integrator-episodes-20260829-2333";
import { early0030IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0014";
import { early0035IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0035";

export function getStaticPaths() {
  return seasons.map((season) => ({ params: { year: season.year }, props: { season } }));
}
const { season } = Astro.props;
const allEpisodes = [...episodes, ...integratedEpisodes, ...wallIntegratedEpisodes, ...whiskeyIntegratedEpisodes, ...coreIntegratedEpisodes, ...coreRecovery1535Episodes, ...allCharactersIntegratedEpisodes, ...louvreIntegratedEpisodes, ...lateAugustIntegratedEpisodes, ...late1737IntegratedEpisodes, ...late2200IntegratedEpisodes, ...late2235IntegratedEpisodes, ...late2333IntegratedEpisodes, ...early0030IntegratedEpisodes, ...early0035IntegratedEpisodes];
const seasonEpisodes = allEpisodes.filter((episode) => episode.season === season.year);
const eraNumber = seasons.findIndex((entry) => entry.year === season.year) + 1;
---
<WikiLayout title={`${season.title} | Underlords Chronicle`} description={season.summary}>
  <div class="breadcrumbs"><a href="/seasons">Chronicle</a> / Era {eraNumber} / {season.year}</div>
  <section class="hero"><div><div class="kicker">ERA {String(eraNumber).padStart(2,"0")} · {season.year}</div><h1>{season.title}</h1><p class="tagline">{season.subtitle}</p></div></section>
  <section class="section detail-layout">
    <article class="detail-main">
      <h2>What changed</h2><p>{season.summary}</p>
      <h2 style="margin-top:4rem">Major incidents</h2>
      {seasonEpisodes.length ? <div class="episode-list">{seasonEpisodes.map((episode)=><a class="episode-row" href={`/episodes/${episode.id}`}><span class="ep-season">{episode.kind}</span><strong>{episode.title}</strong><p>{episode.logline}</p><time>{episode.date}</time></a>)}</div> : <div class="wiki-note">No named incident page yet.</div>}
    </article>
    <aside class="infobox"><div class="infobox-title">{season.title}</div><dl><div class="row"><dt>Era</dt><dd>{eraNumber}</dd></div><div class="row"><dt>Year</dt><dd>{season.year}</dd></div><div class="row"><dt>Theme</dt><dd>{season.subtitle}</dd></div><div class="row"><dt>Incidents</dt><dd>{seasonEpisodes.length} named stories</dd></div></dl></aside>
  </section>
</WikiLayout>