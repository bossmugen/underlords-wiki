---
import WikiLayout from "../../layouts/WikiLayout.astro";
import { episodes, characters } from "../../data/wiki";
import { integratedEpisodes } from "../../data/integrator-episodes";
import { wallIntegratedEpisodes } from "../../data/integrator-episodes-wall-20260828";
import { wallRecoveryEpisodes } from "../../data/integrator-episodes-wall-20260829";
import { wall1830Episodes } from "../../data/integrator-episodes-wall-20260829-1830";
import { wall1930Episodes } from "../../data/integrator-episodes-wall-20260829-1930";
import { whiskeyIntegratedEpisodes } from "../../data/integrator-episodes-whiskey-20260829";
import { coreIntegratedEpisodes } from "../../data/integrator-episodes-core-20260829";
import { coreRecovery1535Episodes } from "../../data/integrator-episodes-core-20260829-1535";
import { core1800Episodes } from "../../data/integrator-episodes-core-20260829-1800";
import { allCharactersIntegratedEpisodes } from "../../data/integrator-episodes-allcharacters-20260829";
import { louvreIntegratedEpisodes } from "../../data/integrator-episodes-louvre-20260829";
import { lateAugustIntegratedEpisodes } from "../../data/integrator-episodes-20260829-1334";
import { late1737IntegratedEpisodes } from "../../data/integrator-episodes-20260829-1737";
import { late2200IntegratedEpisodes } from "../../data/integrator-episodes-20260829-2200";
import { late2235IntegratedEpisodes } from "../../data/integrator-episodes-20260829-2235";
import { late2333IntegratedEpisodes } from "../../data/integrator-episodes-20260829-2333";
import { early0030IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0014";
import { early0035IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0035";
import { early0135IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0135";
import { early0200IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0200";
import { early0224IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0224";
import { early0230IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0230";
import { early0242IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0242";
import { early0435IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0435";
import { early0501IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0501";
import { early0748IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0748";
import { early0836IntegratedEpisodes } from "../../data/integrator-episodes-20260830-0836";
import { late1140IntegratedEpisodes } from "../../data/integrator-episodes-20260830-1140";
import { late1230IntegratedEpisodes } from "../../data/integrator-episodes-20260830-1230";
import { late1314IntegratedEpisodes } from "../../data/integrator-episodes-20260830-1314";
import { late1329WallEpisodes } from "../../data/integrator-episodes-20260830-1329-wall";
import { late1342WallRecoveryEpisodes } from "../../data/integrator-episodes-20260830-1342-wall-recovery";
import { late1414IntegratedEpisodes } from "../../data/integrator-episodes-20260830-1414";
export function getStaticPaths(){return [...episodes, ...integratedEpisodes, ...wallIntegratedEpisodes, ...wallRecoveryEpisodes, ...wall1830Episodes, ...wall1930Episodes, ...whiskeyIntegratedEpisodes, ...coreIntegratedEpisodes, ...coreRecovery1535Episodes, ...core1800Episodes, ...allCharactersIntegratedEpisodes, ...louvreIntegratedEpisodes, ...lateAugustIntegratedEpisodes, ...late1737IntegratedEpisodes, ...late2200IntegratedEpisodes, ...late2235IntegratedEpisodes, ...late2333IntegratedEpisodes, ...early0030IntegratedEpisodes, ...early0035IntegratedEpisodes, ...early0135IntegratedEpisodes, ...early0200IntegratedEpisodes, ...early0224IntegratedEpisodes, ...early0230IntegratedEpisodes, ...early0242IntegratedEpisodes, ...early0435IntegratedEpisodes, ...early0501IntegratedEpisodes, ...early0748IntegratedEpisodes, ...early0836IntegratedEpisodes, ...late1140IntegratedEpisodes, ...late1230IntegratedEpisodes, ...late1314IntegratedEpisodes, ...late1329WallEpisodes, ...late1342WallRecoveryEpisodes, ...late1414IntegratedEpisodes].map((episode)=>({params:{id:episode.id},props:{episode}}));}
const { episode } = Astro.props;
const cast = episode.cast.map((name)=>characters.find((character)=>character.name===name)).filter(Boolean);
const replaceComedyTaxonomy = (value: string) => value.replace(/\b(bits?|gags?)\b/gi, (term) => {
  const replacement = term.toLowerCase().endsWith("s") ? "jokes" : "joke";
  if (term === term.toUpperCase()) return replacement.toUpperCase();
  if (term[0] === term[0].toUpperCase()) return replacement[0].toUpperCase() + replacement.slice(1);
  return replacement;
});
const publicText = (value: string) => replaceComedyTaxonomy(value.replace(/`([^`]+)`/g, '"$1"'));
---
<WikiLayout title={`${publicText(episode.title)} | Underlords Wiki`} description={publicText(episode.logline)}>
  <div class="breadcrumbs"><a href="/episodes">Episodes</a> / {publicText(episode.title)}</div>
  <section class="hero"><div><div class="kicker">{publicText(episode.kind)} · SEASON {Number(episode.season)-2019}</div><h1>{publicText(episode.title)}</h1><p class="tagline">{publicText(episode.logline)}</p></div></section>
  <section class="section detail-layout">
    <article class="detail-main">
      <h2>Synopsis</h2><p>{publicText(episode.logline)}</p>
      <h2 style="margin-top:4rem">Cast</h2>
      <div class="wiki-grid">{cast.map((character:any)=><a class="poster-card" data-initial={character.name[0]} href={`/characters/${character.id}`}><small>{publicText(character.role)}</small><strong>{character.name}</strong><span>{publicText(character.logline)}</span></a>)}</div>
    </article>
    <aside class="infobox"><div class="infobox-title">{publicText(episode.title)}</div><dl><div class="row"><dt>Season</dt><dd>{episode.season}</dd></div><div class="row"><dt>Date</dt><dd>{episode.date}</dd></div><div class="row"><dt>Type</dt><dd>{publicText(episode.kind)}</dd></div><div class="row"><dt>Cast</dt><dd>{episode.cast.join(" · ")}</dd></div></dl></aside>
  </section>
</WikiLayout>