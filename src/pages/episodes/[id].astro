---
import WikiLayout from "../../layouts/WikiLayout.astro";
import { episodes, characters } from "../../data/wiki";
import { integratedEpisodes } from "../../data/integrator-episodes";
import { whiskeyIntegratedEpisodes } from "../../data/integrator-episodes-whiskey-20260828";
export function getStaticPaths(){return [...episodes, ...integratedEpisodes, ...whiskeyIntegratedEpisodes].map((episode)=>({params:{id:episode.id},props:{episode}}));}
const { episode } = Astro.props;
const cast = episode.cast.map((name)=>characters.find((character)=>character.name===name)).filter(Boolean);
const replaceComedyTaxonomy = (value: string) => value.replace(/\b(bits?|gags?)\b/gi, (term) => {
  const replacement = term.toLowerCase().endsWith("s") ? "jokes" : "joke";
  if (term === term.toUpperCase()) return replacement.toUpperCase();
  if (term[0] === term[0].toUpperCase()) return replacement[0].toUpperCase() + replacement.slice(1);
  return replacement;
});
const publicText = (value: string) => replaceComedyTaxonomy(value.replace(/`([^`]+)`/g, '"$1"'));
---
<WikiLayout title={`${publicText(episode.title)} | Underlords Wiki`} description={publicText(episode.logline)}>
  <div class="breadcrumbs"><a href="/episodes">Episodes</a> / {publicText(episode.title)}</div>
  <section class="hero"><div><div class="kicker">{publicText(episode.kind)} · SEASON {Number(episode.season)-2019}</div><h1>{publicText(episode.title)}</h1><p class="tagline">{publicText(episode.logline)}</p></div></section>
  <section class="section detail-layout">
    <article class="detail-main">
      <h2>Synopsis</h2><p>{publicText(episode.logline)}</p>
      <h2 style="margin-top:4rem">Cast</h2>
      <div class="wiki-grid">{cast.map((character:any)=><a class="poster-card" data-initial={character.name[0]} href={`/characters/${character.id}`}><small>{publicText(character.role)}</small><strong>{character.name}</strong><span>{publicText(character.logline)}</span></a>)}</div>
    </article>
    <aside class="infobox"><div class="infobox-title">{publicText(episode.title)}</div><dl><div class="row"><dt>Season</dt><dd>{episode.season}</dd></div><div class="row"><dt>Date</dt><dd>{episode.date}</dd></div><div class="row"><dt>Type</dt><dd>{publicText(episode.kind)}</dd></div><div class="row"><dt>Cast</dt><dd>{episode.cast.join(" · ")}</dd></div></dl></aside>
  </section>
</WikiLayout>