---
import WikiLayout from "../../layouts/WikiLayout.astro";
import { allEpisodes, episodeFormat } from "../../data/all-content";

const episodes = allEpisodes.filter((episode) => episodeFormat(episode) === "EPISODE");
const incidents = allEpisodes.filter((episode) => episodeFormat(episode) === "INCIDENT");
---
<WikiLayout title="Episodes & Incidents | Underlords" description="Named Underlords arcs, incidents, turning points, recurring-story births, scandals, traditions, and archive episodes.">
  <section class="hero">
    <div>
      <div class="kicker">THE SITUATIONS THAT GOT NAMES</div>
      <h1>EPISODES &<br/>INCIDENTS</h1>
      <p class="tagline">An incident happens once. An episode recruits supporting characters, crosses rooms, acquires callbacks, and refuses to die when the timestamp ends. UL has both. Obviously.</p>
      <div class="hero-actions"><a class="ul-button secondary" href="/snoop?type=EPISODES">SNOOP THE CASELOAD</a></div>
    </div>
  </section>

  <section class="section" id="episodes">
    <div class="section-head"><h2>Episodes</h2><p>Arcs, seasons, reunions, recurring objects, and stories too large for one discrete scene.</p></div>
    <div class="episode-list">
      {episodes.map((episode) => (
        <a class="episode-row" href={`/episodes/${episode.id}`}>
          <span class="ep-season">{episode.season}</span><strong>{episode.title}</strong><p>{episode.logline}</p><time>{episode.date}</time>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="incidents">
    <div class="section-head"><h2>Incidents</h2><p>Discrete events, one-night catastrophes, procedural comedy, and moments that permanently damaged the vocabulary.</p></div>
    <div class="episode-list">
      {incidents.map((episode) => (
        <a class="episode-row" href={`/episodes/${episode.id}`}>
          <span class="ep-season">{episode.season}</span><strong>{episode.title}</strong><p>{episode.logline}</p><time>{episode.date}</time>
        </a>
      ))}
    </div>
  </section>
</WikiLayout>
