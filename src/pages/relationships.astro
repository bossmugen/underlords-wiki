---
import WikiLayout from "../layouts/WikiLayout.astro";
import { relationshipGroups, characters } from "../data/wiki";
const byName = (name:string) => characters.find((c)=>c.name===name);
---
<WikiLayout title="Bonds | Underlords Wiki" description="Underlords family bonds, friendships, old ties, recurring pairings, and social connections with story history.">
  <section class="hero"><div><div class="kicker">BONDS · KINSHIP · OLD TIES</div><h1>Bonds</h1><p class="tagline">Some ties begin before UL. Some begin in Raja. Some become family nouns, running jokes, work partnerships, or the reason one person's page keeps dragging another person into frame.</p></div></section>
  <section class="section">
    <div class="section-head"><h2>Relationship-specific bits</h2><p>Not ranks, not legal names, not real-world kinship. Just two-person language that kept enough continuity to earn its own index card.</p></div>
    <div class="wiki-grid">
      <a class="poster-card" data-initial="R" href="/characters/rummy"><small>Gilli → Rummy · 2021–2024</small><strong>Tummy</strong><span>Gilli goes from `RUMMY TUM TUMMY` to `We'll miss you Tummy` to `It never been blue Tummy`. Multi-year nickname rail; not Rummy's canonical alias.</span></a>
      <a class="poster-card" data-initial="M" href="/characters/momo"><small>Mia ↔ Momo · April 2023</small><strong>Mimi & Momo</strong><span>Mia says `me and momo are twinsss`; Momo answers `Mimi’s twin`; two days later Momo true-replies `you are both Mimi & Momo.` UL twin language, not biological siblinghood.</span></a>
      <a class="poster-card" data-initial="T" href="/characters/tofu"><small>Cookie ↔ Tofu · 2021–2024</small><strong>Mutual Wall Destruction</strong><span>Cookie puts Tofu on blast for promised bee spam; Tofu later prosecutes Cookie. Three years later Cookie warns `she bouta expose me`, posts a screenshot at Tofu anyway, and Tofu true-replies with a counter-screenshot and `Oh si? Pues toma`. Recurring evidence warfare, not romance or rank.</span></a>
    </div>
  </section>
  {relationshipGroups.map((group)=><section class="section"><div class="section-head"><h2>{group.title}</h2><p>{group.note}</p></div><div class="wiki-grid">{group.people.map((name)=>{const c=byName(name); return c ? <a class="poster-card" data-initial={c.name[0]} href={`/characters/${c.id}`}><small>{c.role}</small><strong>{c.name}</strong><span>{c.logline}</span></a> : <div class="poster-card" data-initial={name[0]}><strong>{name}</strong></div>})}</div></section>)}
</WikiLayout>
