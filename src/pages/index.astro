---
import WikiLayout from "../layouts/WikiLayout.astro";
import { characters, episodes, seasons, gags } from "../data/wiki";
import { castGroups } from "../data/cast";
const featured = characters.filter((c) => c.billing === "main").slice(0, 8);
const featuredEpisodes = episodes.slice(-6).reverse();
const majorOrders = castGroups.slice(0, 6);
const replaceComedyTaxonomy = (value: string) => value.replace(/\b(bits?|gags?)\b/gi, (term) => {
  const replacement = term.toLowerCase().endsWith("s") ? "jokes" : "joke";
  if (term === term.toUpperCase()) return replacement.toUpperCase();
  if (term[0] === term[0].toUpperCase()) return replacement[0].toUpperCase() + replacement.slice(1);
  return replacement;
});
const publicText = (value: string) => replaceComedyTaxonomy(value.replace(/`([^`]+)`/g, '"$1"'));
---
<WikiLayout title="Underlords Reference Chronicle" description="The reference-mirror wiki for Underlords. The canonical public character, Chronicle, lore, and archive experience now lives on the main Underlords site.">
  <section class="section consolidation-banner">
    <small>CANONICAL PUBLIC SITE</small>
    <h2>The Chronicle moved into the house.</h2>
    <p>This wiki is now the reference mirror. Character biographies, the main chronology, lore, and archive navigation are being consolidated into the main Underlords site so there is one public universe instead of two thinner ones.</p>
    <a href="https://underlords.pages.dev/">OPEN THE MAIN UNDERLORDS SITE ↗</a>
  </section>

  <section class="hero">
    <div>
      <div class="kicker">REFERENCE CHRONICLE</div>
      <h1>UNDERLORDS</h1>
      <p class="tagline">The long-form reference layer behind the main site: eras, characters, incidents, orders, relationships, legends, relics, and archive-backed continuity.</p>
      <dl class="factbox">
        <dt>Canonical public home</dt><dd>underlords.pages.dev</dd>
        <dt>First record</dt><dd>2020</dd>
        <dt>Origin</dt><dd>Dragon Raja club</dd>
        <dt>Continuity</dt><dd>2020 → present archive boundary</dd>
        <dt>Primary subjects</dt><dd>People · rooms · roles · incidents · rituals · artifacts</dd>
        <dt>Current era</dt><dd>2026 — Afterlife / Family Reunion</dd>
      </dl>
    </div>
  </section>

  <section class="section chronicle-intro">
    <div class="section-head">
      <div>
        <div class="kicker">THE GREAT CHRONICLE</div>
        <h2>Seven years.<br/>Seven forms of the same house.</h2>
        <p>The dates are ordinary. What each year turns UL into is not.</p>
      </div>
    </div>
    <div class="era-stack">
      {seasons.map((season, index) => (
        <a class="era-row" href={`/seasons/${season.year}`}>
          <span class="era-index">ERA {String(index + 1).padStart(2,"0")}</span>
          <span class="era-year">{season.year}</span>
          <strong>{publicText(season.title)}</strong>
          <p>{publicText(season.subtitle)}</p>
          <b>↗</b>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Character Codex</h2><p>The figures who keep reappearing across eras, rooms, incidents, family trees, job titles, and somebody else's screenshots.</p></div>
    <div class="wiki-grid">
      {featured.map((character) => (
        <a class="poster-card" data-initial={character.name[0]} href={`/characters/${character.id}`}>
          <small>{publicText(character.role)}</small><strong>{character.name}</strong><span>{publicText(character.logline)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Major Incidents</h2><p>The archive has thousands of scenes. These are the ones that became turning points, named stories, or permanent damage to the vocabulary.</p></div>
    <div class="episode-list">
      {featuredEpisodes.map((episode) => (
        <a class="episode-row" href={`/episodes/${episode.id}`}>
          <span class="ep-season">{episode.season}</span><strong>{publicText(episode.title)}</strong><p>{publicText(episode.logline)}</p><time>{episode.date}</time>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Orders & Affiliations</h2><p>The fake government had real permissions. The ridiculous titles had actual jobs. The hierarchy is part of the story.</p></div>
    <div class="portal-grid">
      {majorOrders.map((group) => (
        <a class="portal-card" href={`/factions#${group.id}`}>
          <small>ORDER / AFFILIATION</small><h3>{publicText(group.label)}</h3><p>{publicText(group.note)}</p>
        </a>
      ))}
      <a class="portal-card" href="/factions"><small>FULL INDEX</small><h3>All orders</h3><p>Officers, Snipers, specialists, Game Officers, Staff, Platelets, VIPs, and the archive cast.</p></a>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Persistent Legends</h2><p>The jokes, names, rituals, accusations, and tiny disasters that kept surviving long enough to become continuity.</p></div>
    <div class="index-list">
      {gags.slice(0,6).map((gag) => <a class="index-card" href={`/gags#${gag.id}`}><small>PERSISTENT LEGEND</small><h3>{publicText(gag.name)}</h3><p>{publicText(gag.logline)}</p></a>)}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Relics & Primary Sources</h2><p>Posters, screenshots, quotes, exports, galleries, and the surviving objects that keep this from turning into folklore by vibes.</p></div>
    <div class="portal-grid">
      <a class="portal-card" href="/gallery"><small>RELICS</small><h3>Gallery</h3><p>The visual objects: art, banners, screenshots, and surviving media.</p></a>
      <a class="portal-card" href="/quotes"><small>VOICE</small><h3>Quotes</h3><p>Lines that survived because somebody refused to let them die.</p></a>
      <a class="portal-card" href="/locations"><small>DOMAINS</small><h3>Rooms & places</h3><p>The named spaces where the mythology actually happened.</p></a>
      <a class="portal-card" href="/archive"><small>PRIMARY SOURCES</small><h3>Archive</h3><p>The source layer beneath the chronicle.</p></a>
    </div>
  </section>
</WikiLayout>

<style>
  .consolidation-banner{margin-top:2rem!important;padding:1.25rem 0 1.5rem;border-top:1px solid rgba(212,171,83,.45);border-bottom:1px solid rgba(212,171,83,.2)}.consolidation-banner small{color:#d7b76a;font-size:.65rem;font-weight:900;letter-spacing:.14em}.consolidation-banner h2{margin:.65rem 0 .7rem;font-size:clamp(2rem,4vw,3.8rem);line-height:.95}.consolidation-banner p{max-width:760px;color:#aaa4ae;line-height:1.65}.consolidation-banner a{display:inline-block;margin-top:.6rem;color:#d7b76a;font-size:.72rem;font-weight:900;text-decoration:none}.consolidation-banner a:hover{color:#fff}
</style>
