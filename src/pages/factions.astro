---
import WikiLayout from "../layouts/WikiLayout.astro";
import { allCharacters, castGroups } from "../data/cast";
const characterById = new Map(allCharacters.map((character) => [character.id, character]));
---
<WikiLayout title="Employment Fraud | Underlords" description="Underlords roles, ranks, specialist offices, guest affiliations, and historical hierarchy.">
  <section class="hero">
    <div>
      <div class="kicker">JOBS · TITLES · ALLEGED MANAGEMENT</div>
      <h1>EMPLOYMENT<br/>FRAUD</h1>
      <p class="tagline">Boss. Underboss. Officers. Snipers. Game Officers. Specialists. Staff. Platelets. VIPs. The titles were ridiculous, the permissions were real, and somebody kept inventing departments until the server needed workers' compensation.</p>
    </div>
  </section>

  <section class="section faction-grid">
    {castGroups.map((group, index) => {
      const members = group.characterIds.map((id) => characterById.get(id)).filter(Boolean);
      return (
        <article class="faction-block" id={group.id}>
          <div class="faction-copy">
            <small>PAYROLL FILE {String(index + 1).padStart(2, "0")}</small>
            <h2>{group.label}</h2>
            <p>{group.note}</p>
          </div>
          <div class="faction-members">
            {members.map((member) => member && (
              <a class="faction-member" href={`/characters/${member.id}`}>
                <strong>{member.name}</strong>
                <span>{member.role} · {member.era}</span>
              </a>
            ))}
          </div>
        </article>
      );
    })}
  </section>
</WikiLayout>
